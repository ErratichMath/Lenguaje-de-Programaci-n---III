package EJS;

public class EJ3 {
	    public static void main(String[] args) {
	        int[] frecuencias = new int[6]; // índice 0 -> cara 1, ..., índice 5 -> cara 6

	        for (int lanzamiento = 0; lanzamiento < 20000; lanzamiento++) {
	            int cara = (int) (Math.random() * 6); // número entero entre 0 y 5
	            frecuencias[cara]++;
	        }

	        System.out.println("Resultado de 20000 lanzamientos de dado:");
	        for (int i = 0; i < frecuencias.length; i++) {
	            System.out.println("Cara " + (i + 1) + ": " + frecuencias[i] + " veces");
	        }
	    }
}
